{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "rotator-image-consumer-group",
    "MaxRequestSize": 10485760
  },
  "KafkaTopics": {
    "RotatorImage": "events.rotator-image",
    "RouterImage": "events.router-image"
  }
}
